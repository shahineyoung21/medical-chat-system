@charset "utf-8";

:root { --pink-50: #fff5f8; --pink-100: #fde4ec; --pink-200: #f9c9d4; --pink-400: #f08fa8; --pink-600: #d65c7d; --ink: #3a2b32; --ink-soft: #7a6a71; --white: #ffffff; --shadow: 0 4px 16px rgba(214, 92, 125, 0.12); --radius: 18px; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html, body { font-family: "Segoe UI", Tahoma, system-ui, -apple-system, sans-serif; background: linear-gradient(160deg, var(--pink-50), var(--pink-100)); color: var(--ink); min-height: 100vh; line-height: 1.6; }

.hero { text-align: center; padding: 2rem 1rem 1rem; }

.hero h1 { font-size: 1.8rem; color: var(--pink-600); margin-bottom: 0.25rem; }

.subtitle { color: var(--ink-soft); font-size: 0.95rem; }

.container { max-width: 560px; margin: 0px auto; padding: 1rem; display: flex; flex-direction: column; gap: 1.25rem; }

.summary-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1.25rem 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; text-align: center; }

.summary-item { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.5rem; }

.summary-item.wide { grid-column: span 3; background: var(--pink-50); border-radius: 12px; }

.summary-value { font-size: 2rem; font-weight: 700; color: var(--pink-600); line-height: 1.1; }

.summary-value.small { font-size: 1.2rem; font-weight: 600; }

.summary-label { font-size: 0.8rem; color: var(--ink-soft); }

.card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1.25rem; }

.card h2 { font-size: 1.1rem; margin-bottom: 1rem; color: var(--pink-600); }

.field { display: block; margin-bottom: 1rem; }

.field span { display: block; font-size: 0.9rem; margin-bottom: 0.35rem; color: var(--ink-soft); font-weight: 600; }

.field input, .field textarea { width: 100%; padding: 0.7rem 0.9rem; border: 1.5px solid var(--pink-100); border-radius: 12px; font-size: 1rem; font-family: inherit; color: var(--ink); background: var(--pink-50); transition: border-color 0.2s, background 0.2s; }

.field input:focus, .field textarea:focus { outline: none; border-color: var(--pink-400); background: var(--white); }

.field textarea { resize: vertical; min-height: 70px; }

.actions { display: flex; gap: 0.75rem; margin-top: 0.5rem; }

.btn { flex: 1 1 0%; padding: 0.8rem 1rem; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; font-family: inherit; transition: transform 0.1s, opacity 0.2s; }

.btn:active { transform: scale(0.98); }

.btn.primary { background: linear-gradient(135deg, var(--pink-400), var(--pink-600)); color: var(--white); box-shadow: rgba(214, 92, 125, 0.3) 0px 4px 12px; }

.btn.ghost { background: transparent; color: var(--pink-600); border: 1.5px solid var(--pink-200); }

.footer { text-align: center; padding: 1rem 0px 2rem; font-size: 0.8rem; color: var(--ink-soft); }

.footer .love { margin-top: 0.5rem; font-size: 0.9rem; color: var(--pink-600); }

@media (max-width: 380px) {
  .summary-value { font-size: 1.6rem; }
  .hero h1 { font-size: 1.5rem; }
}
